# Senha unica do painel de edicao (/admin). Troque por uma senha forte.
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessao do painel.
# Gere um novo com: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

# ATENCAO: estas variaveis sao lidas apenas pelo servico `api` (Node, servidor).
# Nunca prefixe segredos com VITE_ — variaveis VITE_* sao embutidas em texto
# claro no bundle do navegador e ficam visiveis para qualquer visitante.

# --- Backup ---

# Quantos snapshots manter em ./backups (padrao: 14, um por dia = duas semanas).
BACKUP_KEEP=14

# Destino da copia externa, no formato do rclone. Deixe comentado para o backup
# ficar somente local na VPS. Um backup no mesmo servidor protege contra erro do
# cliente, mas nao contra perder o servidor.
# BACKUP_REMOTE=gdrive:dois90-backups
